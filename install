#!/usr/bin/env bash

init() {
    # Vars
    CURRENT_USERNAME='brennan'

    # Colors
    NORMAL=$(tput sgr0)
    WHITE=$(tput setaf 7)
    BLACK=$(tput setaf 0)
    RED=$(tput setaf 1)
    GREEN=$(tput setaf 2)
    YELLOW=$(tput setaf 3)
    BLUE=$(tput setaf 4)
    MAGENTA=$(tput setaf 5)
    CYAN=$(tput setaf 6)
    BRIGHT=$(tput bold)
    UNDERLINE=$(tput smul)
}

confirm() {
    echo -en "[${GREEN}y${NORMAL}/${RED}n${NORMAL}]: "
    read -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 0
    fi
}

print_header() {
    # Added usage instructions for the new install-only option
    echo -E "$RED
      ! To make sure everything runs correctly DONT run as root ! $GREEN
                      -> '"./install.sh"' $NORMAL

    ${CYAN}Usage:${NORMAL}
      ./install.sh              (Full install and configuration)
      ./install.sh --install    (Only runs the install step)
      ./install.sh --config     (Only runs the configuration step)

    ${CYAN}Hosts:${NORMAL}
      desktop      (Ryzen + RTX 3090)
      laptop       (Ryzen 6800H + RTX 3070 Ti, PRIME offload)
      work-laptop  (Core Ultra 9 + RTX PRO 2000 Blackwell, PRIME offload)
    "
}

get_username() {
    echo -en "Enter your$GREEN username$NORMAL : $YELLOW"
    read username
    echo -en "$NORMAL"
    echo -en "Use$YELLOW "$username"$NORMAL as ${GREEN}username${NORMAL} ? "
    confirm
}

set_username() {
    sed -i -e "s/${CURRENT_USERNAME}/${username}/g" ./flake.nix
}

get_host() {
    echo -en "Choose a ${GREEN}host${NORMAL}: [${YELLOW}D${NORMAL}]esktop, [${YELLOW}L${NORMAL}]aptop or [${YELLOW}W${NORMAL}]ork laptop: "
    read -n 1 -r
    echo

    if [[ $REPLY =~ ^[Dd]$ ]]; then
        HOST='desktop'
        IS_LAPTOP=0
    elif [[ $REPLY =~ ^[Ll]$ ]]; then
        HOST='laptop'
        IS_LAPTOP=1
    elif [[ $REPLY =~ ^[Ww]$ ]]; then
        HOST='work-laptop'
        IS_LAPTOP=1
    else
        echo "Invalid choice. Please select 'D' for desktop, 'L' for laptop or 'W' for work laptop."
        exit 1
    fi

    echo -en "$NORMAL"
    echo -en "Use the$YELLOW "$HOST"$NORMAL ${GREEN}host${NORMAL} ? "
    confirm
}

# 0000:00:02.0 -> PCI:0:2:0  (nvidia expects decimal, lspci prints hex)
pci_to_nix_bus_id() {
    local addr="${1#0000:}"
    local bus="${addr%%:*}"
    local rest="${addr#*:}"
    printf 'PCI:%d:%d:%d' "0x${bus}" "0x${rest%%.*}" "0x${rest#*.}"
}

# First PCI address whose *vendor/device description* matches $2. The class
# string must be excluded from the match: "VGA compATIble controller" otherwise
# false-matches an `ati` vendor pattern on every GPU line.
gpu_addr_matching() {
    echo "$1" | awk -F': ' -v re="$2" 'tolower($2) ~ re { split($1, f, " "); print f[1]; exit }'
}

# hardware.nvidia.prime.* bus IDs are per-machine, so read them off the running
# hardware instead of trusting whatever is committed.
set_prime_bus_ids() {
    local nvidia_file="hosts/${HOST}/nvidia.nix"

    if [ ! -f "$nvidia_file" ] || ! grep -q 'nvidiaBusId' "$nvidia_file"; then
        return 0
    fi

    local gpus igpu_attr igpu_addr nvidia_addr igpu_id nvidia_id
    # `|| true`: a missing vendor is a normal outcome here, not an error, and
    # this must not blow up under `set -e` if the script is ever sourced.
    gpus=$(lspci -D | grep -E 'VGA compatible controller|3D controller|Display controller' || true)
    nvidia_addr=$(gpu_addr_matching "$gpus" 'nvidia')
    igpu_addr=$(gpu_addr_matching "$gpus" 'intel')

    if [ -n "$igpu_addr" ]; then
        igpu_attr='intelBusId'
    else
        igpu_addr=$(gpu_addr_matching "$gpus" 'advanced micro devices|amd/ati')
        igpu_attr='amdgpuBusId'
    fi

    if [ -z "$nvidia_addr" ] || [ -z "$igpu_addr" ]; then
        echo -e "${YELLOW}Could not detect both GPUs; leaving PRIME bus IDs in ${MAGENTA}${nvidia_file}${YELLOW} alone.${NORMAL}"
        return 0
    fi

    if ! grep -q "$igpu_attr" "$nvidia_file"; then
        echo -e "${RED}${nvidia_file} has no ${igpu_attr} — this machine's iGPU vendor does not match the ${HOST} host config.${NORMAL}"
        return 0
    fi

    igpu_id=$(pci_to_nix_bus_id "$igpu_addr")
    nvidia_id=$(pci_to_nix_bus_id "$nvidia_addr")

    echo -e "Writing detected PRIME bus IDs to ${MAGENTA}${nvidia_file}${NORMAL}: ${GREEN}${igpu_attr} = \"${igpu_id}\"${NORMAL}, ${GREEN}nvidiaBusId = \"${nvidia_id}\"${NORMAL}"
    sed -i -E "s|(${igpu_attr}[[:space:]]*=[^\"]*\")[^\"]*\"|\1${igpu_id}\"|" "$nvidia_file"
    sed -i -E "s|(nvidiaBusId[[:space:]]*=[^\"]*\")[^\"]*\"|\1${nvidia_id}\"|" "$nvidia_file"
}

install_desktop() {
    echo -e "\n${RED}START INSTALL PHASE${NORMAL}\n"
    sleep 0.2

    # Get the hardware configuration
    echo -e "Copying ${MAGENTA}/etc/nixos/hardware-configuration.nix${NORMAL} to ${MAGENTA}./hosts/${HOST}/${NORMAL}\n"
    cp /etc/nixos/hardware-configuration.nix hosts/${HOST}/hardware-configuration.nix
    sleep 0.2

    # Pin PRIME offload to this machine's actual PCI topology
    set_prime_bus_ids
    sleep 0.2

    # Build the system (flakes + home manager)
    echo -e "\nBuilding the system...\n"
    sudo nixos-rebuild switch --flake .#${HOST}
}

configure_desktop() {
    echo -e "\n${RED}START CONFIGURATION PHASE${NORMAL}\n"
    sleep 0.2

    # Create basic directories
    echo -e "Creating folders:"
    mkdir -p ~/.local/bin
    mkdir -p ~/Pictures/wallpapers
    mkdir -p ~/.config/emacs
    sleep 0.2

    echo -e "Linking ${MAGENTA}wallpapers${NORMAL}"
    # Note: This links the files inside the wallpapers dir, not the dir itself
    ln -sf "$PWD/configs/${HOST}/wallpapers/"* ~/Pictures/wallpapers/
    sleep 0.2

    echo -e "Linking ${MAGENTA}Xresources config${NORMAL}"
    ln -sf "$PWD/configs/${HOST}/Xresources" ~/.Xresources
    sleep 0.2

    echo -e "Linking ${MAGENTA}emacs config${NORMAL}"
    # Assuming this script is run from the repo root that contains 'configs/'
    ln -sf "$PWD/configs/common/emacs/init.el" "$PWD/configs/common/emacs/early-init.el" ~/.config/emacs/
    sleep 0.2

    # Conditionally link laptop-specific configs
    if [ "$IS_LAPTOP" = "1" ]; then
        echo -e "Linking ${MAGENTA}libinput gestures config${NORMAL} for ${HOST}"
        ln -sf "$PWD/configs/${HOST}/libinput-gestures.conf" ~/.config/libinput-gestures.conf
        sleep 0.2
    fi
}

reboot() {
    echo -en "Would you like to reboot now "
    confirm
    sudo reboot now
}

main() {
    init
    print_header

    # Check the first command-line argument for mode selection
    if [[ "$1" == "--config" || "$1" == "-c" ]]; then
        echo -e "${YELLOW}Running in configuration-only mode...${NORMAL}"
        get_host
        configure_desktop
        echo -e "\n${GREEN}Configuration complete.${NORMAL}"
        exit 0
    elif [[ "$1" == "--install" || "$1" == "-i" ]]; then
        echo -e "${YELLOW}Running in install-only mode...${NORMAL}"
        get_username
        set_username
        get_host
        install_desktop
        reboot
        exit 0
    fi

    # Default: full installation and configuration flow
    echo -e "${YELLOW}Running in default (full install) mode...${NORMAL}"
    get_username
    set_username
    get_host
    install_desktop
    configure_desktop
    reboot
}

# Pass all script arguments to the main function
main "$@" && exit 0
